{
  "manifest_version": 3,
  "name": "Capital One Offers Miles Sorter",
  "version": "2.1.0",
  "description": "Sort Capital One Offers tiles by highest miles, lowest miles, highest X multiples, or original order.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://capitaloneoffers.com/*"
  ],
  "action": {
    "default_title": "Capital One Offers Miles Sorter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://capitaloneoffers.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
